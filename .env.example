# Get a free key at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# Which model to use. Good defaults:
# llama-3.3-70b-versatile   (best quality)
# llama-3.1-8b-instant      (fastest)
GROQ_MODEL=llama-3.3-70b-versatile

# Set this to any random string to password-protect your chat so random
# people who find the URL can't burn through your free API quota.
ACCESS_KEY=

PORT=3000
